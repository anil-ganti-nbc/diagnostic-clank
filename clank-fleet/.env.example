# clank-fleet Stage 0 environment variable template
# Copy to .env for local experimentation. Never commit real secrets.

# Naming convention: CLANK_<AREA>_<SETTING>
# Examples: CLANK_FLEET_API_HOST, CLANK_RUNTIME_LOG_LEVEL

CLANK_ENV=stage0
CLANK_FLEET_API_HOST=127.0.0.1
CLANK_FLEET_API_PORT=8000

# Path conventions (use forward slashes or pathlib; no Windows drive letters in code)
# CLANK_DATA_ROOT=/var/lib/clank
# CLANK_EVIDENCE_ROOT=/var/lib/clank/evidence

# Secret handling guidance:
# - Store secrets in a secret manager or OS keyring in later stages.
# - Never put production tokens in this file or in source control.
# - Stage 0 has no authentication; these are placeholders only.
# CLANK_API_TOKEN=
# CLANK_BACKUP_PASSPHRASE=

# Service ID naming: lowercase, hyphen-separated (e.g. oem-radar, fleet-api)
